{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Config",
  "description": "Schema of optional config.json in application CWD",
  "type": "object",
  "properties": {
    "uri": {
      "description": "Redis URI.",
      "default": "redis://127.0.0.1",
      "type": "string"
    },
    "channel": {
      "description": "Redis Channel.",
      "default": "jutemplate",
      "type": "string"
    }
  }
}
